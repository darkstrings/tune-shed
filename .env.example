NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/tuneshed
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=<your_secret>
PAGINATION_LIMIT=8

# PayPal (https://developer.paypal.com → Apps & Credentials, use Sandbox while testing)
PAYPAL_CLIENT_ID=<your_paypal_client_id>
PAYPAL_APP_SECRET=<your_paypal_secret>
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Optional
# UPLOAD_DIR=/var/data/uploads        # where product photos are stored (Render disk)
# SEED_ADMIN_EMAIL=admin@email.com    # used by `npm run data:import`
# SEED_ADMIN_PASSWORD=change-me
