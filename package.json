{
  "name": "tuneshed",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Tune Shed — a MERN guitar shop with PayPal checkout",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node backend/server.js",
    "server": "node --watch-path=backend backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run server\" \"npm run client\"",
    "test": "node --test \"backend/tests/*.test.js\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d",
    "data:demo-users": "node backend/seeder.js --demo-users",
    "build": "npm install && npm install --prefix frontend --include=dev && npm run build --prefix frontend"
  },
  "author": "Lucien Gaydos",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
